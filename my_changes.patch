diff --git a/nf/convert_to_btrfs.sh b/nf/convert_to_btrfs.sh
new file mode 100644
index 0000000000..af0a332102
--- /dev/null
+++ b/nf/convert_to_btrfs.sh
@@ -0,0 +1,191 @@
+#!/bin/bash
+
+# 设置颜色
+GREEN='\033[0;32m'
+YELLOW='\033[1;33m'
+RED='\033[0;31m'
+CYAN='\033[0;36m'
+NC='\033[0m' # No Color
+
+log() {
+    echo -e "${GREEN}[INFO] $1${NC}"
+}
+
+warn() {
+    echo -e "${YELLOW}[WARN] $1${NC}"
+}
+
+err() {
+    echo -e "${RED}[ERROR] $1${NC}"
+}
+
+section() {
+    echo -e "\n${CYAN}=== $1 ===${NC}"
+}
+
+if [ $(id -u) -ne 0 ]; then
+    err "请使用 sudo (root权限) 运行此脚本"
+    exit 1
+fi
+
+# 检查工具依赖
+for cmd in mkfs.btrfs rsync losetup blkid gunzip; do
+    if ! command -v $cmd &> /dev/null; then
+        err "缺少必要工具: $cmd，请先安装"
+        exit 1
+    fi
+done
+
+# 1. 检查参数与自动寻径
+SOURCE_IMG="$1"
+DEFAULT_GZ="/home/Nuofang/immortalwrt/bin/targets/rockchip/armv8/immortalwrt-rockchip-armv8-friendlyarm_nanopi-r2s-ext4-sysupgrade.img.gz"
+
+if [ -z "$SOURCE_IMG" ]; then
+    log "未指定参数，尝试寻找默认镜像..."
+    if [ -f "$DEFAULT_GZ" ]; then
+        log "找到默认压缩镜像: $DEFAULT_GZ"
+        log "正在解压镜像..."
+        # 解压到当前目录，去掉 .gz 后缀
+        gunzip -c "$DEFAULT_GZ" > "./$(basename "${DEFAULT_GZ%.gz}")"
+        SOURCE_IMG="./$(basename "${DEFAULT_GZ%.gz}")"
+    else
+        err "未指定参数且未找到默认镜像文件: $DEFAULT_GZ"
+        exit 1
+    fi
+fi
+
+if [ ! -f "$SOURCE_IMG" ]; then
+    err "文件不存在: $SOURCE_IMG"
+    exit 1
+fi
+
+section "1. 准备工作"
+TARGET_IMG="${SOURCE_IMG%.*}-btrfs.img"
+log "正在创建镜像副本，保留原文件..."
+log "源文件: $SOURCE_IMG"
+log "目标文件: $TARGET_IMG"
+
+cp --sparse=always "$SOURCE_IMG" "$TARGET_IMG"
+if [ $? -ne 0 ]; then
+    err "创建副本失败！"
+    exit 1
+fi
+
+# 3. 挂载镜像
+log "正在挂载镜像文件..."
+LOOP_DEV=$(losetup -fP --show "$TARGET_IMG")
+
+if [ -z "$LOOP_DEV" ]; then
+    err "挂载失败！"
+    exit 1
+fi
+
+log "镜像已挂载到: $LOOP_DEV"
+
+# 假设 p2 是 rootfs
+ROOT_PART="${LOOP_DEV}p2"
+
+if [ ! -b "$ROOT_PART" ]; then
+    err "未找到分区 $ROOT_PART，请确认镜像分区结构是否正确"
+    losetup -d "$LOOP_DEV"
+    exit 1
+fi
+
+# 4. 准备临时目录
+TEMP_MOUNT="/tmp/openwrt_convert_mnt"
+TEMP_BACKUP="/tmp/openwrt_convert_backup"
+mkdir -p "$TEMP_MOUNT" "$TEMP_BACKUP"
+
+section "2. 备份数据"
+log "挂载原 EXT4 分区..."
+mount "$ROOT_PART" "$TEMP_MOUNT"
+# 延迟1秒确保挂载操作稳定
+sleep 1
+
+if [ $? -ne 0 ]; then
+    err "无法挂载原分区"
+    losetup -d "$LOOP_DEV"
+    exit 1
+fi
+
+log "正在备份系统文件 (这可能需要几秒钟)..."
+rsync -aAX --info=progress2 --exclude "lost+found" "$TEMP_MOUNT/" "$TEMP_BACKUP/"
+
+if [ $? -ne 0 ]; then
+    err "备份失败！"
+    umount "$TEMP_MOUNT"
+    losetup -d "$LOOP_DEV"
+    exit 1
+fi
+
+umount "$TEMP_MOUNT"
+log "备份完成。"
+
+section "3. 格式化与还原"
+log "正在将 $ROOT_PART 格式化为 Btrfs..."
+mkfs.btrfs -f -L rootfs -m single "$ROOT_PART"
+if [ $? -ne 0 ]; then
+    err "格式化失败！"
+    losetup -d "$LOOP_DEV"
+    exit 1
+fi
+
+log "挂载新的 Btrfs 分区..."
+mount -t btrfs -o compress=zstd "$ROOT_PART" "$TEMP_MOUNT"
+sleep 1
+
+log "设置根目录压缩属性 (zstd)..."
+btrfs property set "$TEMP_MOUNT" compression zstd
+
+log "正在还原系统文件..."
+rsync -aAX --info=progress2 "$TEMP_BACKUP/" "$TEMP_MOUNT/"
+
+section "4. 更新系统配置"
+log "生成新的 UCI fstab 配置..."
+NEW_UUID=$(blkid -s UUID -o value "$ROOT_PART")
+log "检测到新 UUID: $NEW_UUID"
+
+UCI_FSTAB="$TEMP_MOUNT/etc/config/fstab"
+
+# 如果目录不存在则创建
+mkdir -p "$(dirname "$UCI_FSTAB")"
+
+# 写入或追加配置
+cat >> "$UCI_FSTAB" <<EOF
+
+config mount
+        option target '/'
+        option uuid '$NEW_UUID'
+        option enabled '1'
+        option fstype 'btrfs'
+        option options 'rw,noatime,compress=zstd,space_cache=v2,commit=60'
+EOF
+
+log "已更新 $UCI_FSTAB"
+
+echo "
+pi_suppress_stderr="y"
+fs_failsafe_wait_timeout=1
+pi_init_path="/usr/sbin:/usr/bin:/sbin:/bin"
+pi_init_env=""
+pi_init_cmd="/sbin/init"
+pi_init_suppress_stderr="y"
+pi_ifname=""
+pi_ip="192.168.1.1"
+pi_netmask="255.255.255.0"
+pi_broadcast="192.168.1.255"
+pi_preinit_net_messages=""
+pi_preinit_no_failsafe_netmsg=""
+pi_preinit_no_failsafe=""
+
+" | tee "$TEMP_MOUNT/lib/preinit/00_preinit.conf"
+
+section "5. 清理与完成"
+log "正在清理..."
+umount "$TEMP_MOUNT"
+losetup -d "$LOOP_DEV"
+rm -rf "$TEMP_MOUNT" "$TEMP_BACKUP"
+
+echo -e "\n${GREEN}=== 转换成功！ ===${NC}"
+echo -e "新镜像文件: ${YELLOW}$TARGET_IMG${NC}"
+echo -e "提示: 如果原镜像已解压，你可能需要手动删除临时生成的 .img 文件。"
\ No newline at end of file
