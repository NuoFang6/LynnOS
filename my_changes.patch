++int lrng_drng_sleep_while_nonoperational(int nonblock)
++{
++	lrng_force_fully_seeded();
++	if (likely(lrng_state_operational()))
++		return 0;
++	if (nonblock)
++		return -EAGAIN;
++	return wait_event_interruptible(lrng_init_wait,
++					lrng_state_operational());
++}
