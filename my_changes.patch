++	config LRNG_COLLECTION_SIZE_32
++	depends on LRNG_CONTINUOUS_COMPRESSION_ENABLED
++	depends on !LRNG_SWITCHABLE_CONTINUOUS_COMPRESSION
++	depends on !CRYPTO_FIPS
