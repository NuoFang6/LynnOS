++static inline int
++lrng_set_drng_cb(const struct lrng_drng_cb *cb) { return -EOPNOTSUPP; }
++static inline int
++lrng_set_hash_cb(const struct lrng_hash_cb *cb) { return -EOPNOTSUPP; }
++#endif	/* CONFIG_LRNG_SWITCH */
