+@@ -29,3 +29,8 @@ obj-$(CONFIG_LRNG_JENT)			+= lrng_es_jen
+ obj-$(CONFIG_LRNG_HEALTH_TESTS)		+= lrng_health.o
+ obj-$(CONFIG_LRNG_TESTING)		+= lrng_testing.o
