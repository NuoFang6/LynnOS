++# config LRNG_JENT
++# 	bool "Enable Jitter RNG as LRNG Seed Source"
++# 	depends on CRYPTO
++# 	select CRYPTO_JITTERENTROPY
++# 	help
++# 	  The LRNG may use the Jitter RNG as entropy source. Enabling
