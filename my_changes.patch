++	.hash_cb			= h_cb, \
++	.requests			= ATOMIC_INIT(LRNG_DRNG_RESEED_THRESH),\
++	.requests_since_fully_seeded	= ATOMIC_INIT(0), \
++	.last_seeded			= 0, \
