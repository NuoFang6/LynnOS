++#	default 256 if LRNG_JENT_ENTROPY_BLOCKS_NO_256
++#	default 512 if LRNG_JENT_ENTROPY_BLOCKS_NO_512
++#	default 1024 if LRNG_JENT_ENTROPY_BLOCKS_NO_1024
