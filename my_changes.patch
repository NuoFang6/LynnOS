++{
++	u32 i;
++
++	for_each_lrng_es(i) {
++		if (lrng_es[i]->reset)
++			lrng_es[i]->reset();
++	}
++	lrng_state.lrng_operational = false;
++	lrng_state.lrng_fully_seeded = false;
++	lrng_state.lrng_min_seeded = false;
++	lrng_state.all_online_numa_node_seeded = false;
++	pr_debug("reset LRNG\n");
++}
