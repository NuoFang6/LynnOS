+-# 	  test the effectiveness of the SP800-90B RCT health test.
+-#
+-# 	  If unsure, say N.
+-#
+-# config LRNG_APT_BROKEN
+-# 	bool "SP800-90B APT with dangerous low cutoff value"
+-# 	depends on LRNG_HEALTH_TESTS
+-# 	depends on BROKEN
