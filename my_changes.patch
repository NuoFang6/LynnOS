++		for_each_thread(leader, sibling) {
++			if (count >= BURST_CACHE_STOP_COUNT) break;
++
++			if (!task_is_bore_eligible(sibling)) continue;
++			count++;
++			total += sibling->bore.penalty;
++		}
++
++		update_burst_cache(bc, leader, count, total, now);
++	}
++
++	return bc->penalty;
++}
