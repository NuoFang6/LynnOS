++			     &lrng_sha_hash_cb),
++	.lock = __MUTEX_INITIALIZER(lrng_drng_init.lock),
++};
++
++/* Prediction-resistance DRNG: only deliver as much data as received entropy */
++static struct lrng_drng lrng_drng_pr = {
