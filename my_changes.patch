++
++/********************************** Helper ************************************/
++
++bool lrng_get_available(void)
++{
++	return likely(atomic_read(&lrng_avail));
++}
++
++struct lrng_drng *lrng_drng_init_instance(void)
++{
++	return &lrng_drng_init;
++}
